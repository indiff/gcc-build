# syntax=docker/dockerfile:1.7 ARG BASE_IMAGE=ubuntu:24.04 FROM ${BASE_IMAGE} ARG TARGETARCH ENV DEBIAN_FRONTEND=noninteractive \ LANG=C.UTF-8 \ LC_ALL=C.UTF-8 \ TZ=UTC \ JOBS= \ PATH=/opt/gcc/bin:${PATH} SHELL ["/bin/bash", "-o", "pipefail", "-c"] # Keep the image small and install the same toolchain prerequisites on every base OS. # CentOS-specific notes: # - CentOS 7 / CentOS Stream 8 are EOL: their official mirrors are gone, so the # repos must be switched to vault.centos.org (and EPEL 7 to the Fedora archive). # - isl-devel / libmpc-devel live in the PowerTools (Stream 8) / CRB (Stream 9) # repos, which are disabled by default; they must be enabled or `dnf install` # fails with "Unable to find a match". # - CentOS 7 ships GCC 4.8, too old to build current GCC master; devtoolset-11 # (GCC 11 via SCL) is installed and enabled at runtime by build-gcc.sh. RUN set -eux; \ if command -v apt-get >/dev/null 2>&1; then \ apt-get update; \ apt-get install -y --no-install-recommends \ autoconf automake bison build-essential ca-certificates curl file flex \ gawk git gzip libgmp-dev libisl-dev libmpc-dev libmpfr-dev libtool \ make patch perl pkg-config texinfo unzip wget xz-utils zlib1g-dev; \ rm -rf /var/lib/apt/lists/*; \ elif command -v dnf >/dev/null 2>&1; then \ . /etc/os-release; \ case "${VERSION_ID:-}" in \ 8*) \ sed -i 's|^mirrorlist=|#mirrorlist=|g; s|^#baseurl=http://mirror.centos.org|baseurl=https://vault.centos.org|g; s|^#baseurl=http://mirror.stream.centos.org|baseurl=https://vault.centos.org|g' /etc/yum.repos.d/*.repo || true; \ dnf install -y dnf-plugins-core; \ dnf config-manager --set-enabled powertools || true; \ dnf install -y gcc-toolset-12 || true; \ ;; \ 9*) \ dnf install -y dnf-plugins-core; \ dnf config-manager --set-enabled crb || true; \ ;; \ esac; \ dnf install -y \ autoconf automake bison ca-certificates curl file flex gcc gcc-c++ gawk \ git gzip gmp-devel isl-devel libmpc-devel mpfr-devel libtool make patch \ perl pkgconf-pkg-config tar texinfo unzip wget xz zlib-devel; \ dnf clean all; \ elif command -v yum >/dev/null 2>&1; then \ if grep -qE 'release 7|release 8' /etc/centos-release 2>/dev/null; then \ sed -i 's|^mirrorlist=|#mirrorlist=|g; s|^#baseurl=http://mirror.centos.org|baseurl=https://vault.centos.org|g; s|^#baseurl=http://mirror.stream.centos.org|baseurl=https://vault.centos.org|g' /etc/yum.repos.d/CentOS-*.repo 2>/dev/null || true; \ sed -i 's|^mirrorlist=|#mirrorlist=|g; s|^#baseurl=http://mirror.centos.org|baseurl=https://vault.centos.org|g' /etc/yum.repos.d/CentOS-SCLo-scl*.repo 2>/dev/null || true; \ fi; \ yum install -y epel-release || true; \ if grep -qE 'release 7' /etc/centos-release 2>/dev/null; then \ sed -i 's|^metalink=|#metalink=|g; s|^#baseurl=http://download.fedoraproject.org/pub/epel|baseurl=https://archives.fedoraproject.org/pub/archive/epel|g; s|^#baseurl=https://download.fedoraproject.org/pub/epel|baseurl=https://archives.fedoraproject.org/pub/archive/epel|g' /etc/yum.repos.d/epel.repo || true; \ yum install -y centos-release-scl || true; \ # SCLo repo files are only created by centos-release-scl, so switch them # to vault *after* installing it, otherwise devtoolset installs fail. sed -i 's|^mirrorlist=|#mirrorlist=|g; s|^#baseurl=http://mirror.centos.org|baseurl=https://vault.centos.org|g' /etc/yum.repos.d/CentOS-SCLo-scl*.repo 2>/dev/null || true; \ # Install separately: devtoolset-12 has no aarch64 build on CentOS 7, # and one missing package fails the whole yum transaction. yum install -y devtoolset-12 || true; \ yum install -y devtoolset-11 || true; \ fi; \ yum groupinstall -y 'Development Tools' || yum groupinstall -y 'Development tools' || true; \ yum install -y \ autoconf automake bison ca-certificates curl file flex gcc gcc-c++ gawk \ git gzip gmp-devel isl-devel libmpc-devel mpfr-devel libtool make patch \ perl pkgconfig tar texinfo unzip wget xz zlib-devel; \ yum clean all; \ else \ echo 'Unsupported base image: no apt-get, dnf, or yum found' >&2; exit 1; \ fi WORKDIR /workspace COPY build-gcc.sh /usr/local/bin/build-gcc.sh RUN chmod 0755 /usr/local/bin/build-gcc.sh ENTRYPOINT ["/usr/local/bin/build-gcc.sh"]