# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    JOBS= \
    PATH=/opt/gcc/bin:${PATH}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Keep the image small and install the same toolchain prerequisites on every base OS.
# Oracle Linux notes:
#  - Oracle Linux repos remain maintained, no vault mirror switch required.
#  - isl-devel / libmpc-devel / mpfr-devel are in CodeReady Builder (CRB) repo.
#    OL7: ol7_software_collections, OL8: ol8_codeready_builder, OL9: ol9_codeready_builder
#  - Oracle Linux 7 ships GCC 4.8.5, too old to build current GCC master;
#    install devtoolset-12/devtoolset-11 via SCL, enabled at runtime by build-gcc.sh.
RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        autoconf automake bison build-essential ca-certificates curl file flex \
        gawk git gzip libgmp-dev libisl-dev libmpc-dev libmpfr-dev libtool \
        make patch perl pkg-config texinfo unzip wget xz-utils zlib1g-dev; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      . /etc/os-release; \
      case "${VERSION_ID:-}" in \
        8*) \
          dnf install -y dnf-plugins-core; \
          dnf config-manager --set-enabled ol8_codeready_builder || true; \
          dnf install -y gcc-toolset-12 || true; \
          ;; \
        9*) \
          dnf install -y dnf-plugins-core; \
          dnf config-manager --set-enabled ol9_codeready_builder || true; \
          ;; \
      esac; \
      dnf install -y \
        autoconf automake bison ca-certificates curl file flex gcc gcc-c++ gawk \
        git gzip gmp-devel isl-devel libmpc-devel mpfr-devel libtool make patch \
        perl pkgconf-pkg-config tar texinfo unzip wget xz zlib-devel; \
      dnf clean all; \
    elif command -v yum >/dev/null 2>&1; then \
      # Oracle Linux 7, no vault repo rewrite needed
      yum install -y oracle-epel-release-el7 || true; \
      if grep -q "Oracle Linux Server release 7" /etc/oracle-release 2>/dev/null; then \
        yum install -y oracle-softwarecollection-release-el7 || true; \
        # Install separately: devtoolset-12 aarch64 missing on OL7, avoid transaction fail
        yum install -y devtoolset-12 || true; \
        yum install -y devtoolset-11 || true; \
      fi; \
      yum groupinstall -y 'Development Tools' || yum groupinstall -y 'Development tools' || true; \
      yum install -y \
        autoconf automake bison ca-certificates curl file flex gcc gcc-c++ gawk \
        git gzip gmp-devel isl-devel libmpc-devel mpfr-devel libtool make patch \
        perl pkgconfig tar texinfo unzip wget xz zlib-devel; \
      yum clean all; \
    else \
      echo 'Unsupported base image: no apt-get, dnf, or yum found' >&2; exit 1; \
    fi

WORKDIR /workspace
COPY build-gcc.sh /usr/local/bin/build-gcc.sh
RUN chmod 0755 /usr/local/bin/build-gcc.sh

ENTRYPOINT ["/usr/local/bin/build-gcc.sh"]
