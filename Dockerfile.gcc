# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive

# 设置语言环境变量
ENV LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    TZ=Asia/Shanghai \
    LC_ALL=zh_CN.UTF-8 \
    LC_CTYPE=zh_CN.UTF-8 \
    LC_NUMERIC=zh_CN.UTF-8 \
    LC_TIME=zh_CN.UTF-8 \
    LC_COLLATE=zh_CN.UTF-8 \
    LC_MONETARY=zh_CN.UTF-8 \
    LC_MESSAGES=zh_CN.UTF-8 \
    LC_PAPER=zh_CN.UTF-8 \
    LC_NAME=zh_CN.UTF-8 \
    LC_ADDRESS=zh_CN.UTF-8 \
    LC_TELEPHONE=zh_CN.UTF-8 \
    LC_MEASUREMENT=zh_CN.UTF-8 \
    LC_IDENTIFICATION=zh_CN.UTF-8 \
    JOBS= \
    PATH=/opt/gcc-indiff/bin:/root/.cargo/bin:${PATH}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 编译gcc基础依赖，移除所有gmp/isl/mpc/mpfr系统包，由gcc源码脚本自动编译
RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        systemd language-pack-zh-hans language-pack-zh-hans-base tzdata locales  \
        autoconf automake bison build-essential bzip2 ca-certificates curl file flex cmake \
        gawk git gzip libtool make patch perl pkg-config texinfo unzip wget xz-utils libssl-dev zlib1g-dev; \
      # Ubuntu生成中文locale
      locale-gen zh_CN.UTF-8; \
      update-locale LANG=zh_CN.UTF-8 LC_ALL=zh_CN.UTF-8; \  
      # 安装rustup for Ubuntu
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y; \  
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      . /etc/os-release; \
      case "${VERSION_ID:-}" in \
        8*) \
          dnf install -y dnf-plugins-core; \
          dnf config-manager --set-enabled ol8_codeready_builder || true; \
          dnf install -y oracle-epel-release-el8 || true; \
          dnf install -y gcc-toolset-12 || true; \
          ;; \
        9*) \
          dnf install -y dnf-plugins-core; \
          dnf config-manager --set-enabled ol9_codeready_builder || true; \
          dnf install -y oracle-epel-release-el9 || true; \
          ;; \
      esac; \
      dnf install -y \
            autoconf automake bison bzip2 ca-certificates curl file flex gcc gcc-c++ gawk \
            cmake openssl-devel glibc-langpack-zh \
            git gzip libtool make patch perl pkgconf-pkg-config tar texinfo unzip wget xz zlib-devel; \
        # 安装rustup for OracleLinux
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y; \
      dnf clean all; \
    elif command -v yum >/dev/null 2>&1; then \
      yum install -y oracle-epel-release-el7 || true; \
      if grep -q "Oracle Linux Server release 7" /etc/oracle-release 2>/dev/null; then \
        yum install -y oracle-softwarecollection-release-el7 || true; \
        yum install -y devtoolset-12 || true; \
        yum install -y devtoolset-11 || true; \
      fi; \
      yum groupinstall -y 'Development Tools' || yum groupinstall -y 'Development tools' || true; \
      # OL7中文语言包
      yum install -y \
          autoconf automake bison bzip2 ca-certificates curl file flex gcc gcc-c++ gawk \
          git gzip libtool make patch perl pkgconfig tar texinfo unzip wget xz zlib-devel \
          glibc-langpack-zh; \
      # Oracle Linux7 同样安装rustup
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y; \  
      yum clean all; \
    else \
      echo 'Unsupported base image: no apt-get, dnf, or yum found' >&2; exit 1; \
    fi; \
    # 校验cargo可用
    /root/.cargo/bin/cargo --version \
    # 校验locale是否正常生成
    locale -a

WORKDIR /workspace
COPY build-gcc.sh /usr/local/bin/build-gcc.sh
RUN chmod 0755 /usr/local/bin/build-gcc.sh

ENTRYPOINT ["/usr/local/bin/build-gcc.sh"]
