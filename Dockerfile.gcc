# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    JOBS= \
    PATH=/opt/gcc/bin:${PATH}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Keep the image small and install the same toolchain prerequisites on every base OS.
RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        autoconf automake bison build-essential ca-certificates curl file flex \
        gawk git gzip libgmp-dev libisl-dev libmpc-dev libmpfr-dev libtool \
        make patch perl pkg-config texinfo unzip wget xz-utils zlib1g-dev; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf install -y \
        autoconf automake bison ca-certificates curl file flex gcc gcc-c++ gawk \
        git gzip gmp-devel isl-devel libmpc-devel mpfr-devel libtool make patch \
        perl pkgconf-pkg-config tar texinfo unzip wget xz zlib-devel; \
      dnf clean all; \
    elif command -v yum >/dev/null 2>&1; then \
      if grep -qE 'release 7|release 8' /etc/centos-release 2>/dev/null; then \
        sed -i 's|^mirrorlist=|#mirrorlist=|g; s|^#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-*.repo || true; \
      fi; \
      yum install -y epel-release || true; \
      yum groupinstall -y 'Development Tools'; \
      yum install -y \
        autoconf automake bison ca-certificates curl file flex gcc gcc-c++ gawk \
        git gzip gmp-devel isl-devel libmpc-devel mpfr-devel libtool make patch \
        perl pkgconfig tar texinfo unzip wget xz zlib-devel; \
      yum clean all; \
    else \
      echo 'Unsupported base image: no apt-get, dnf, or yum found' >&2; exit 1; \
    fi

WORKDIR /workspace
COPY build-gcc.sh /usr/local/bin/build-gcc.sh
RUN chmod 0755 /usr/local/bin/build-gcc.sh

ENTRYPOINT ["/usr/local/bin/build-gcc.sh"]
